/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_USART1_UART_Init();
  MX_ADC1_Init();
  /* USER CODE BEGIN 2 */

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
	    /* --- Phan C: moi 200 ms khoi dong 1 lan chuyen doi, CPU khong cho --- */
	    if (HAL_GetTick() - t_adc >= 200)
	    {
	      t_adc = HAL_GetTick();
	      HAL_ADC_Start_IT(&hadc1);
	    }

	    /* --- Phan D: xu ly mau moi do ISR ADC bao --- */
	    if (adc_new)
	    {
	      adc_new = 0;
	      HAL_GPIO_WritePin(GPIOB, GPIO_PIN_9,
	                        (adc_mV > THRESH_MV) ? GPIO_PIN_SET : GPIO_PIN_RESET);
	      if (auto_send)
	      {
	        char s[40];
	        int n = snprintf(s, sizeof s, "ADC=%u (%u mV)\r\n", adc_raw, adc_mV);
	        HAL_UART_Transmit(&huart1, (uint8_t*)s, n, 50);
	      }
	    }

	    /* --- Phan B: phan tich dong lenh do ISR UART bao --- */
	    if (line_ready)
	    {
	      if      (strcmp(line, "LED ON")     == 0) HAL_GPIO_WritePin(GPIOC, GPIO_PIN_13, GPIO_PIN_RESET);
	      else if (strcmp(line, "LED OFF")    == 0) HAL_GPIO_WritePin(GPIOC, GPIO_PIN_13, GPIO_PIN_SET);
	      else if (strcmp(line, "LED TOGGLE") == 0) HAL_GPIO_TogglePin(GPIOC, GPIO_PIN_13);
	      else if (strcmp(line, "ADC?")       == 0)
	      {
	        char s[40];
	        int n = snprintf(s, sizeof s, "ADC=%u (%u mV)\r\n", adc_raw, adc_mV);
	        HAL_UART_Transmit(&huart1, (uint8_t*)s, n, 50);
	      }
	      else HAL_UART_Transmit(&huart1, (uint8_t*)"ERR\r\n", 5, 50);

	      line_idx   = 0;      /* cho nhan dong moi */
	      line_ready = 0;
	    }
  /* USER CODE END 3 */
}

