#define LINE_MAX   32
#define VREF_MV    3300U
#define ADC_MAX    4095U
#define THRESH_MV  2500U

volatile uint32_t isr_cnt    = 0;
volatile uint8_t  adc_new    = 0;
volatile uint16_t adc_raw    = 0;
volatile uint16_t adc_mV     = 0;
uint8_t           rx_byte;
char              line[LINE_MAX];
volatile uint8_t  line_idx   = 0;
volatile uint8_t  line_ready = 0;
volatile uint8_t  auto_send  = 0;



void HAL_GPIO_EXTI_Callback(uint16_t GPIO_Pin)
{
  static uint32_t last_tick = 0;
  if (GPIO_Pin == GPIO_PIN_0)
  {
    isr_cnt++;
    uint32_t now = HAL_GetTick();
    if (now - last_tick >= 200)
    {
      last_tick = now;
      HAL_GPIO_TogglePin(GPIOC, GPIO_PIN_13);
      auto_send ^= 1;
    }
  }
}
/* Phan B: ngat nhan UART1, ghep byte thanh dong lenh */
void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart)
{
  if (huart->Instance == USART1)
  {
    char c = (char)rx_byte;
    if (c == '\r' || c == '\n')
    {
      if (line_idx > 0) { line[line_idx] = '\0'; line_ready = 1; }
    }
    else if (line_idx < LINE_MAX - 1 && !line_ready)
    {
      line[line_idx++] = c;
    }
    HAL_UART_Receive_IT(&huart1, &rx_byte, 1);
  }
}

void HAL_UART_ErrorCallback(UART_HandleTypeDef *huart)
{
  if (huart->Instance == USART1)
  {
    __HAL_UART_CLEAR_OREFLAG(huart);
    HAL_UART_Receive_IT(&huart1, &rx_byte, 1);
  }
}

/* Phan C: ngat ket thuc chuyen doi ADC (EOC) */
void HAL_ADC_ConvCpltCallback(ADC_HandleTypeDef *hadc)
{
  if (hadc->Instance == ADC1)
  {
    adc_raw = (uint16_t)HAL_ADC_GetValue(hadc);  /* doc DR = xoa co EOC */
    adc_mV  = (uint16_t)((uint32_t)adc_raw * VREF_MV / ADC_MAX);
    adc_new = 1;
  }
}
